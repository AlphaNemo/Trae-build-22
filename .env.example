# 复制本文件为 .env 并填入真实值。
# .env 已在 .gitignore 中忽略，严禁把真实 key 提交到仓库。
#
# 本项目不引入 python-dotenv；启动前二选一：
#   PowerShell：$env:OPENAI_API_KEY="sk-xxx"; $env:OPENAI_BASE_URL="https://..."; py main.py
#   或由 ai/ 配置模块按下列变量名读取本文件。

# OpenAI 兼容接口（GPT / Claude / 通义 / 豆包 / DeepSeek 等，更换 BASE_URL 即可切换）
OPENAI_API_KEY=sk-在这里填你的key
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名（按所选厂商实际名称修改）
MODEL_NAME=gpt-4o-mini
VLM_MODEL_NAME=gpt-4o
ASR_MODEL_NAME=whisper-1

# AI 请求超时秒数（现场网络不可信，超时后降级到 mock 假数据）
AI_TIMEOUT=20
